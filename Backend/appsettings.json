{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=TunnelSecurity;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True",
    "TimeSeries": "Host=localhost;Port=5433;Database=tunnel_timeseries;Username=postgres;Password=123"
  },
  "TimeSeries": {
    "Enabled": true
  },
  "DataRetention": {
    "Days": 90
  },
  "Camera": {
    "PeriodicClip": {
      "IntervalMinutes": 1,
      "DurationSeconds": 5
    }
  },
  "Devices": {
    "Mqtt": {
      "BrokerHost": "localhost",
      "BrokerPort": 1883,
      "ClientId": "tunnel-backend",
      "TopicPrefix": "tunnel",
      "Enabled": false
    },
    "Http": {
      "PollIntervalSeconds": 30,
      "Enabled": false,
      "Endpoints": []
    },
    "WebSocket": {
      "Enabled": false,
      "Endpoints": []
    },
    "HealthCheck": {
      "IntervalSeconds": 30,
      "OfflineTimeoutSeconds": 60
    }
  }
}
