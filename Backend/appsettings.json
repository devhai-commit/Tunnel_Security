{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "DefaultConnection": "Server=.\\SQLEXPRESS;Database=TunnelSecurity;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True",
        "LegacyPostgresConnection": "Host=localhost;Port=5432;Database=TunnelSecurity;Username=postgres;Password=123456"
    },

    "Jwt": {
        "Issuer": "TunnelSecurity",
        "Audience": "TunnelSecurity.Client",
        "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_32+",
        "RefreshTokenDays": 30,
        "AccessTokenMinutes": 60
    },
    "LoginSecurity": {
        "MaxFailedLoginAttempts": 5,
        "FailedAttemptWindowMinutes": 15,
        "LockoutMinutes": 15
    }
}
