            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#60A5FA"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography & Spacing -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeNormal">14</x:Double>
    <x:Double x:Key="FontSizeMedium">16</x:Double>
    <x:Double x:Key="FontSizeLarge">20</x:Double>
    <x:Double x:Key="FontSizeXLarge">24</x:Double>
    <x:Double x:Key="FontSizeXXLarge">32</x:Double>

    <x:Double x:Key="SpacingTiny">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">20</x:Double>
    <x:Double x:Key="SpacingXXLarge">24</x:Double>

    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>

    <Thickness x:Key="BorderThicknessNormal">1</Thickness>
    <Thickness x:Key="BorderThicknessMedium">2</Thickness>

    <!-- ====================================
    Dark UI Palette — dùng cho các trang monitoring (luôn dark, không phụ thuộc theme)
    ==================================== -->

    <!-- Backgrounds — matched to MonitoringDashboard palette -->
    <SolidColorBrush x:Key="DkBgBrush"         Color="#0F1526"/>
    <SolidColorBrush x:Key="DkSurfaceBrush"    Color="#171E33"/>
    <SolidColorBrush x:Key="DkDeepBrush"       Color="#0F1526"/>
    <SolidColorBrush x:Key="DkInputBgBrush"    Color="#0B1020"/>
    <SolidColorBrush x:Key="DkHoverSurfaceBrush"   Color="#1C222D"/>
    <SolidColorBrush x:Key="DkPressedSurfaceBrush" Color="#2D3545"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="DkBorderBrush"     Color="#2D3238"/>
    <SolidColorBrush x:Key="DkBorderSubtleBrush" Color="#1F2429"/>
    <SolidColorBrush x:Key="DkBorderHoverBrush"  Color="#475569"/>

    <!-- Text -->
    <SolidColorBrush x:Key="DkTextPrimaryBrush"   Color="#E6EEF3"/>
    <SolidColorBrush x:Key="DkTextSecondaryBrush" Color="#C4C8CF"/>
    <SolidColorBrush x:Key="DkTextMutedBrush"     Color="#96A0B3"/>
    <SolidColorBrush x:Key="DkTextDimBrush"       Color="#8794A6"/>

    <!-- Accent Blue -->
    <SolidColorBrush x:Key="DkBlueBrush"       Color="#2979FF"/>
    <SolidColorBrush x:Key="DkBlueMidBrush"    Color="#3B82F6"/>
    <SolidColorBrush x:Key="DkBlueLightBrush"  Color="#60A5FA"/>
    <SolidColorBrush x:Key="DkBlueDarkBrush"   Color="#144BB8"/>
    <SolidColorBrush x:Key="DkBlueBgBrush"     Color="#0D1D3B"/>
    <SolidColorBrush x:Key="DkBlueBorderBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="DkBluePressedBrush" Color="#1E40AF"/>

    <!-- Status colors — exact per DESIGN.md severity grammar -->
    <SolidColorBrush x:Key="DkGreenBrush"      Color="#3FCF8E"/>
    <SolidColorBrush x:Key="DkGreenBgBrush"    Color="#0D2B1A"/>
    <SolidColorBrush x:Key="DkYellowBrush"     Color="#FFD166"/>
    <SolidColorBrush x:Key="DkYellowBgBrush"   Color="#3D2E14"/>
    <SolidColorBrush x:Key="DkOrangeBrush"     Color="#FF8C42"/>
    <SolidColorBrush x:Key="DkOrangeBgBrush"   Color="#3D2218"/>
    <SolidColorBrush x:Key="DkRedBrush"        Color="#FF5252"/>
    <SolidColorBrush x:Key="DkRedBgBrush"      Color="#3D1A1A"/>
    <SolidColorBrush x:Key="DkGrayBrush"       Color="#7B7E85"/>
    <SolidColorBrush x:Key="DkGrayBgBrush"     Color="#1A1F2A"/>

    <!-- Dimmed backdrop scrim for fullscreen/focus overlays — lets the dimmed content
         underneath still peek through instead of a fully opaque cut. -->
    <SolidColorBrush x:Key="DkScrimBrush"      Color="#CC0B1020"/>

    <!-- Sensor-type visualization — sparklines in Data Monitoring panel -->
    <!-- Encode sensor identity, NOT severity state. Hues chosen outside the severity grammar. -->
