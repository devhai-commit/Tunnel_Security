<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.EditNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chỉnh sửa Node"
    PrimaryButtonText="Lưu thay đổi"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    RequestedTheme="Dark"
    Background="{StaticResource MonitoringPanelBackgroundBrush}"
    BorderBrush="{StaticResource MonitoringBorderBrush}"
    CornerRadius="8"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="EditFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource MonitoringBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MonitoringTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonitoringBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Width="400">
        <StackPanel Spacing="16" Margin="0,12,0,0">

            <!-- Validation Error Banner -->
            <Border x:Name="ErrorBanner"
                    Background="#3F1111"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#EF4444"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Node Name -->
            <StackPanel>
                <TextBlock Text="Tên Node *"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource MonitoringTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NodeNameTextBox"
                         PlaceholderText="Ví dụ: N1, Node-01..."
                         Style="{StaticResource EditFieldTextBoxStyle}"/>
            </StackPanel>

            <!-- Line Selection -->
            <StackPanel>
                <TextBlock Text="Tuyến *"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource MonitoringTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="LineComboBox"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Chọn tuyến">
                    <ComboBoxItem Content="Tuyến A1"/>
                    <ComboBoxItem Content="Tuyến A2"/>
                    <ComboBoxItem Content="Tuyến A3"/>
                </ComboBox>
            </StackPanel>

            <!-- Location -->
            <StackPanel>
                <TextBlock Text="Vị trí *"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource MonitoringTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="LocationTextBox"
                         PlaceholderText="Ví dụ: R1, Khu vực 1..."
                         Style="{StaticResource EditFieldTextBoxStyle}"/>
            </StackPanel>

            <!-- Sensor count info -->
            <Border Background="{StaticResource MonitoringBackgroundBrush}"
                    BorderBrush="{StaticResource MonitoringBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE957;" FontSize="14"
                              Foreground="{StaticResource MonitoringTextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="SensorCountInfoText"
                               FontSize="12"
                               Foreground="{StaticResource MonitoringTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
