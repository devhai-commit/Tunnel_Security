{
  "version": 8,
  "glyphs": "https://app.local/Map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "vietnam": {
      "type": "vector",
      "url": "pmtiles://https://app.local/Map/Data/vietnam.pmtiles",
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8fafc" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "vietnam",
      "source-layer": "water",
      "paint": { "fill-color": "#bae6fd" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "vietnam",
      "source-layer": "landcover",
      "paint": { "fill-color": "#e2e8f0" }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "vietnam",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#cbd5e1",
        "line-width": 1.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "vietnam",
      "source-layer": "building",
      "paint": {
        "fill-color": "#f1f5f9",
        "fill-outline-color": "#e2e8f0"
      }
    },
    {
      "id": "transportation_name",
      "type": "symbol",
      "source": "vietnam",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": "{name}",
        "text-font": [ "Noto Sans Regular" ],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "vietnam",
      "source-layer": "place",
      "minzoom": 10,
      "layout": {
        "text-field": "{name}",
        "text-font": [ "Noto Sans Bold" ],
        "text-size": 13,
        "text-variable-anchor": [ "top", "bottom", "left", "right" ],
        "text-radial-offset": 0.5
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}