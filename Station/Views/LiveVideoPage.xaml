<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Station.Views.LiveVideoPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Station.ViewModels"
    xmlns:converters="using:Station.Converters"
    xmlns:controls="using:Station.Controls"
    xmlns:views="using:Station.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundSecondaryBrush}">

    <Page.Resources>
        <ThemeShadow x:Key="CommonShadow"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Alert Banner: only visible when alerts are active -->
            <RowDefinition Height="Auto"/>
            <!-- Top title bar: spans full width above the sidebar/content split -->
            <RowDefinition Height="Auto"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             ALERT BANNER (blinks red when there are active alerts)
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                x:Name="AlertBanner"
                Visibility="{x:Bind ViewModel.HasActiveAlerts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource MonitoringAlertBadgePressedBrush}" Padding="0">
        <!-- Inner grid: blink overlay + content stacked -->
        <Grid>
            <!-- Blink highlight: alternates between dark/bright red -->
            <Border Visibility="{x:Bind ViewModel.AlertBannerHighlight, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource LiveAlertBannerBrightBrush}"/>
            <Border Visibility="{x:Bind ViewModel.AlertBannerHighlight, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="{StaticResource MonitoringAlertBadgePressedBrush}"/>

            <!-- Content row -->
            <Grid Padding="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: icon + message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{StaticResource LiveAlertAccentBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE814;" FontSize="{StaticResource FontSizeMedium}" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSizeNormal}" FontWeight="Bold" Foreground="White">
                            <Run Text="CẢNH BÁO KHẨN CẤP"/>
                            <Run Text=" · "/>
                            <Run Text="{x:Bind ViewModel.ActiveAlertCount, Mode=OneWay}"/>
                            <Run Text=" camera phát hiện sự cố"/>
                        </TextBlock>
                        <TextBlock Text="Nhấn 'Xem ngay' để mở video và nội dung cảnh báo"
                                   FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource LiveAlertTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: action button -->
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.ShowMostCriticalAlertCommand}"
                        VerticalAlignment="Center"
                        Background="{StaticResource LiveAlertActionButtonBrush}" BorderThickness="0"
                        CornerRadius="4" Height="36" Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7EF;" FontSize="{StaticResource FontSizeNormal}" Foreground="White"/>
                        <TextBlock Text="Xem ngay" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             TOP TITLE BAR (full width, hidden while fullscreen)
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Padding="20,10"
                Background="{StaticResource DkBgBrush}"
                BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.IsCameraFocused, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="GIÁM SÁT TRỰC TIẾP" FontSize="{StaticResource FontSizeNormal}" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="{StaticResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>

                    <Border Background="{StaticResource DkSurfaceBrush}" Padding="10,5"
                            Height="36" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SeverityLowBrush}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="{StaticResource FontSizeSmall}" FontFamily="Consolas" VerticalAlignment="Center">
                                <Run Text="Hoạt động:" Foreground="{StaticResource DkTextDimBrush}"/>
                                <Run Text="{x:Bind ViewModel.ActiveCameras, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DkTextPrimaryBrush}"/>
                                <Run Text="/" Foreground="{StaticResource DkTextDimBrush}"/>
                                <Run Text="{x:Bind ViewModel.TotalCameras, Mode=OneWay}" Foreground="{StaticResource DkTextDimBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource DkSecondaryButtonStyle}"
                            Height="36" MinHeight="36" MaxHeight="36" MinWidth="0" Padding="12,0"
                            ToolTipService.ToolTip="Thay đổi bố cục"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE80A;" FontSize="{StaticResource FontSizeBody}"/>
                            <TextBlock Text="BỐ CỤC" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource FontSizeXSmall}" Opacity="0.6"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="1×1 - Đơn" Command="{x:Bind ViewModel.ChangeLayoutCommand}" CommandParameter="1">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="2×2 - Lưới 4" Command="{x:Bind ViewModel.ChangeLayoutCommand}" CommandParameter="4">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89A;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="3×3 - Lưới 9" Command="{x:Bind ViewModel.ChangeLayoutCommand}" CommandParameter="9">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="4×4 - Lưới 16" Command="{x:Bind ViewModel.ChangeLayoutCommand}" CommandParameter="16">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FE;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource DkIconButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshStreamsCommand}"
                            ToolTipService.ToolTip="Làm mới">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource FontSizeNormal}" Foreground="{StaticResource DkTextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             CONTENT: sidebar + camera grid
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Sidebar: Camera List ─── -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundPrimaryBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar header (always visible) -->
                    <Grid x:Name="SidebarHeaderGrid" Grid.Row="0" Padding="16,13,10,13"
                          BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="SidebarTitlePanel" Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="DANH SÁCH CAMERA" FontSize="{StaticResource FontSizeBody}" FontFamily="Consolas" FontWeight="SemiBold"
                                       CharacterSpacing="20"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Kéo camera vào ô trống để xem" FontSize="{StaticResource FontSizeCompact}" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Button x:Name="SidebarToggleButton"
                                Grid.Column="1"
                                Click="SidebarToggle_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="32" Height="32" Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Thu gọn danh sách">
                            <FontIcon x:Name="SidebarToggleIcon"
                                      Glyph="&#xE76B;"
                                      FontSize="{StaticResource FontSizeBody}"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Collapsible content (hidden when sidebar collapsed) -->
                    <Grid x:Name="SidebarCollapsibleContent" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Alert summary chip -->
                        <Border Grid.Row="0"
                                Visibility="{x:Bind ViewModel.HasActiveAlerts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{StaticResource LiveAlertChipBgBrush}" BorderBrush="{StaticResource MonitoringAlertBadgePressedBrush}" BorderThickness="0,0,0,1"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource LiveAlertAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="{StaticResource FontSizeSmall}" FontFamily="Consolas" Foreground="{StaticResource LiveAlertTextBrush}" VerticalAlignment="Center">
                                    <Run Text="{x:Bind ViewModel.ActiveAlertCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" cảnh báo đang hoạt động"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Camera list: each row is a drag source -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CameraStreams, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:CameraStreamViewModel">
                                        <Grid CanDrag="True" Background="Transparent"
                                              DragStarting="CameraListItem_DragStarting"
                                              DropCompleted="CameraListItem_DropCompleted"
                                              PointerEntered="CameraListItem_PointerEntered"
                                              PointerExited="CameraListItem_PointerExited">
                                            <Grid.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.2"/>
                                            </Grid.OpacityTransition>
                                            <Grid.BackgroundTransition>
                                                <BrushTransition Duration="0:0:0.15"/>
                                            </Grid.BackgroundTransition>
                                            <!-- Bottom divider -->
                                            <Rectangle Height="1" VerticalAlignment="Bottom"
                                                       Fill="{StaticResource BorderLightBrush}" Opacity="0.22"/>

                                            <!-- Alert state row: full-tint background + leading dot + text carry the
                                                 state (no side-stripe accent — background tint already does that job) -->
                                            <Grid Background="{StaticResource LiveAlertRowBgBrush}"
                                                  Visibility="{x:Bind HasAlert, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid Padding="14,10,16,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind CameraName}"
                                                                   FontSize="{StaticResource FontSizeBody}" FontFamily="Consolas" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource LiveAlertCardTitleBrush}"/>
                                                        <TextBlock Text="{x:Bind AlertTitle}"
                                                                   FontSize="{StaticResource FontSizeCompact}" FontFamily="Consolas" Foreground="{StaticResource LiveAlertTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="1" Width="7" Height="7"
                                                             Fill="{x:Bind AlertSeverityBrush, Mode=OneWay}" VerticalAlignment="Center"
                                                             Opacity="{x:Bind AlertBorderOpacity, Mode=OneWay}"/>
                                                    <!-- Keyboard/non-drag equivalent of dragging this row onto a slot -->
                                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                            Width="28" Height="28" Padding="6"
                                                            Command="{Binding ElementName=PageRoot, Path=ViewModel.AssignToFirstEmptySlotCommand}"
                                                            CommandParameter="{x:Bind}"
                                                            IsEnabled="{Binding ElementName=PageRoot, Path=ViewModel.HasEmptySlots, Mode=OneWay}"
                                                            ToolTipService.ToolTip="Thêm vào lưới hiển thị"
                                                            AutomationProperties.Name="Thêm vào lưới hiển thị">
                                                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>

                                            <!-- Normal state row: drag handle + status dot + name + keyboard add-to-grid -->
                                            <Grid Padding="14,10,16,10"
                                                  Visibility="{x:Bind HasAlert, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="{StaticResource FontSizeSmall}"
                                                          Foreground="{StaticResource TextTertiaryBrush}"
                                                          VerticalAlignment="Center"
                                                          ToolTipService.ToolTip="Kéo để hiển thị"/>

                                                <!-- Fill is transparent when offline (hollow ring vs. solid dot) so status
                                                     doesn't rely on hue alone; AutomationProperties.Name gives screen
                                                     readers the same "Online"/"Offline" signal. -->
                                                <Ellipse Grid.Column="2" Width="8" Height="8"
                                                         Fill="{x:Bind StatusFillBrush, Mode=OneWay}"
                                                         Stroke="{x:Bind StatusColor, Mode=OneWay}" StrokeThickness="1.2"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{x:Bind StatusText, Mode=OneWay}"/>

                                                <StackPanel Grid.Column="4" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind CameraName}"
                                                               FontSize="{StaticResource FontSizeBody}" FontFamily="Consolas" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{x:Bind CameraId}"
                                                               FontSize="{StaticResource FontSizeCompact}" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                                </StackPanel>

                                                <!-- Keyboard/non-drag equivalent of dragging this row onto a slot -->
                                                <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                                                        Width="28" Height="28" Padding="6"
                                                        Command="{Binding ElementName=PageRoot, Path=ViewModel.AssignToFirstEmptySlotCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        IsEnabled="{Binding ElementName=PageRoot, Path=ViewModel.HasEmptySlots, Mode=OneWay}"
                                                        ToolTipService.ToolTip="Thêm vào lưới hiển thị"
                                                        AutomationProperties.Name="Thêm vào lưới hiển thị">
                                                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── Main area: hint banner + camera grid ─── -->
            <Grid Grid.Column="1" Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ─── Camera Grid (collapsed while fullscreen overlay is active) ───
                     Plain Grid panel (not ItemsWrapGrid) so slots can span 2 rows/columns:
                     Grid.Row/Column/RowSpan/ColumnSpan are assigned to each generated
                     container in code-behind, since a spanning cell must keep its
                     covered neighbor's grid space reserved rather than reflowing it. -->
                <Grid Grid.Row="1" x:Name="VideoGridContainer"
                      Visibility="{x:Bind ViewModel.IsCameraFocused, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                      SizeChanged="VideoGridContainer_SizeChanged">
                    <ItemsControl x:Name="CameraItemsControl"
                                  Loaded="CameraItemsControl_Loaded"
                                  ItemsSource="{x:Bind ViewModel.Slots, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CameraSlotViewModel">
                                <Grid AllowDrop="True" DragOver="Slot_DragOver" Drop="Slot_Drop"
                                      DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave">
                                <Grid Margin="0,0,12,12" Opacity="{x:Bind ResizePreviewOpacity, Mode=OneWay}">

                                    <!-- ── Empty slot: dashed drop target ── -->
                                    <Grid Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Rectangle Stroke="{StaticResource BorderLightBrush}" StrokeThickness="1.5"
                                                   StrokeDashArray="4,3" RadiusX="6" RadiusY="6"
                                                   Fill="{StaticResource BackgroundPrimaryBrush}" Opacity="0.6"/>
                                        <!-- Highlighted while a dragged camera hovers over this slot -->
                                        <Rectangle Stroke="{StaticResource PrimaryMediumBrush}" StrokeThickness="2"
                                                   StrokeDashArray="4,3" RadiusX="6" RadiusY="6"
                                                   Fill="{StaticResource PrimaryMediumBrush}"
                                                   Opacity="{x:Bind DragHighlightOpacity, Mode=OneWay}">
                                            <Rectangle.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.15"/>
                                            </Rectangle.OpacityTransition>
                                        </Rectangle>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    Background="{StaticResource BackgroundSecondaryBrush}">
                                                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeLarge}"
                                                          Foreground="{StaticResource TextTertiaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Kéo camera vào đây" FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind SlotLabel, Mode=OneWay}" FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ── Filled slot: DataContext switches to the assigned camera so the
                                         card content below can use classic {Binding} unchanged ── -->
                                    <Grid DataContext="{x:Bind AssignedCamera, Mode=OneWay}"
                                          Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                                        <!-- ── Normal card (no alert) ── -->
                                        <Border Visibility="{Binding HasAlert, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Background="{StaticResource BackgroundPrimaryBrush}"
                                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                CornerRadius="4" Shadow="{StaticResource CommonShadow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Card header -->
                                                <Grid Grid.Row="0" Padding="12,9"
                                                      BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Width="8" Height="8" CornerRadius="4"
                                                                Background="{Binding StatusFillBrush, Mode=OneWay}"
                                                                BorderBrush="{Binding StatusColor, Mode=OneWay}" BorderThickness="1.2"
                                                                AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"/>
                                                        <TextBlock Text="{Binding CameraName}"
                                                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CameraId}"
                                                                   FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="20" Height="20" Padding="2"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ClearSlotCommand}"
                                                                CommandParameter="{x:Bind}"
                                                                ToolTipService.ToolTip="Bỏ khỏi lưới hiển thị">
                                                            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Video area -->
                                                <Grid Grid.Row="1">
                                                    <controls:CameraVideoControl
                                                        StreamUrl="{Binding StreamUrl, Mode=OneWay}"
                                                        IsOnline="{Binding IsOnline, Mode=OneWay}"
                                                        IsStreamEnabled="{Binding IsStreamEnabled, Mode=OneWay}"
                                                        SelectedResolution="{Binding Resolution, Mode=OneWay}"/>
                                                    <!-- Online overlays -->
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                                                                Orientation="Horizontal" Spacing="4"
                                                                Visibility="{Binding IsOnline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <!-- Neutral, not red — "online" isn't an alert, and red is reserved for severity -->
                                                        <Border Background="{StaticResource LiveVideoBadgeOverlayBrush}" CornerRadius="4" Padding="5,2">
                                                            <TextBlock Text="LIVE" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <Border Background="{StaticResource LiveVideoBadgeOverlayBrush}" CornerRadius="4" Padding="5,2"
                                                                Visibility="{Binding IsRecording, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <FontIcon Glyph="&#xE7C8;" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource LiveAlertAccentBrush}"/>
                                                                <TextBlock Text="REC" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6"
                                                            Background="{StaticResource LiveVideoBadgeOverlayBrush}" CornerRadius="4" Padding="5,2"
                                                            Visibility="{Binding IsOnline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding BitrateDisplay, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}" Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Card footer -->
                                                <Grid Grid.Row="2" Padding="10,7"
                                                      Background="{StaticResource BackgroundSecondaryBrush}"
                                                      CornerRadius="0,0,4,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Resolution chip — click to open selector flyout -->
                                                        <Button Padding="4,2" Height="22" CornerRadius="4"
                                                                Background="{StaticResource BackgroundPrimaryBrush}"
                                                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                                ToolTipService.ToolTip="Chọn độ phân giải">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Resolution, Mode=OneWay}" FontSize="{StaticResource FontSizeXSmall}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="70"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource FontSizeMicro}"
                                                                          Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="Top">
                                                                    <MenuFlyoutItem Text="320×240 — SD"
                                                                                    Command="{Binding SetResolutionCommand}"
                                                                                    CommandParameter="320×240"/>
                                                                    <MenuFlyoutItem Text="640×480 — VGA"
                                                                                    Command="{Binding SetResolutionCommand}"
                                                                                    CommandParameter="640×480"/>
                                                                    <MenuFlyoutItem Text="1280×720 — HD"
                                                                                    Command="{Binding SetResolutionCommand}"
                                                                                    CommandParameter="1280×720"/>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Border Background="{StaticResource BackgroundPrimaryBrush}" CornerRadius="4" Padding="4,2"
                                                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                                            <TextBlock FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="{Binding Fps, Mode=OneWay}"/>
                                                                <Run Text=" FPS"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <!-- Local video chip: visible when a video file is loaded -->
                                                        <Border Background="{StaticResource LiveVideoChipBgBrush}" CornerRadius="4" Padding="4,2"
                                                                BorderBrush="{StaticResource LiveVideoChipBorderBrush}" BorderThickness="1"
                                                                Visibility="{Binding HasLocalVideo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE8B2;" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource LiveVideoChipIconBrush}"/>
                                                                <TextBlock Text="{Binding LocalVideoFileName, Mode=OneWay}" FontSize="{StaticResource FontSizeXSmall}"
                                                                           Foreground="{StaticResource LiveVideoChipTextBrush}" MaxWidth="80"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Button Style="{StaticResource IconButtonStyle}" Width="14" Height="14" Padding="1"
                                                                        Click="ClearVideo_Click"
                                                                        ToolTipService.ToolTip="Xóa video">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource LiveVideoChipTextBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <!-- Toggle stream on/off -->
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Padding="4"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ToggleStreamCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTipService.ToolTip="{Binding StreamToggleTooltip, Mode=OneWay}">
                                                            <FontIcon Glyph="{Binding StreamToggleIcon, Mode=OneWay}"
                                                                      Foreground="{Binding StreamToggleColor, Mode=OneWay}"
                                                                      FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Padding="4"
                                                                Click="ChooseVideo_Click"
                                                                ToolTipService.ToolTip="Chọn video cục bộ">
                                                            <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Padding="4"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ToggleRecordingCommand}"
                                                                CommandParameter="{Binding}" ToolTipService.ToolTip="Ghi hình">
                                                            <FontIcon Glyph="{Binding RecordingIcon, Mode=OneWay}"
                                                                      Foreground="{Binding RecordingColor, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Padding="4"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.TakeSnapshotCommand}"
                                                                CommandParameter="{Binding}" ToolTipService.ToolTip="Chụp ảnh">
                                                            <FontIcon Glyph="&#xE722;" FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Button>
                                                        <!-- Fullscreen / expand camera -->
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Padding="4"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.FocusCameraCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTipService.ToolTip="Phóng to">
                                                            <FontIcon Glyph="&#xE740;" FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- ── ALERT CARD (blinks red border) ── -->
                                        <Border Visibility="{Binding HasAlert, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{StaticResource LiveAlertCardBgBrush}"
                                                CornerRadius="4" Shadow="{StaticResource CommonShadow}"
                                                BorderThickness="2">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{Binding AlertSeverityColor, Mode=OneWay}"
                                                    Opacity="{Binding AlertBorderOpacity, Mode=OneWay}"/>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Alert card header -->
                                                <Grid Grid.Row="0" Padding="12,9" Background="{StaticResource LiveAlertCardHeaderBgBrush}"
                                                      CornerRadius="3,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding AlertSeverityBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CameraName}"
                                                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource LiveAlertCardTitleBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{Binding AlertSeverityBrush, Mode=OneWay}"
                                                                CornerRadius="4" Padding="6,2" Opacity="0.9">
                                                            <TextBlock Text="{Binding AlertSeverityText}"
                                                                       FontSize="{StaticResource FontSizeXSmall}" FontWeight="Bold" Foreground="White"
                                                                       CharacterSpacing="60"/>
                                                        </Border>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="20" Height="20" Padding="2"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ClearSlotCommand}"
                                                                CommandParameter="{x:Bind}"
                                                                ToolTipService.ToolTip="Bỏ khỏi lưới hiển thị">
                                                            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource LiveAlertTextBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Alert video area with overlay: border pulse + badges + icon + title
                                                     already carry the alert unmistakably, so this stays a plain dark
                                                     backdrop rather than adding a decorative texture on top -->
                                                <Grid Grid.Row="1" Background="{StaticResource LiveAlertCardVideoBgBrush}">
                                                    <!-- LIVE badge -->
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                                                                Orientation="Horizontal" Spacing="4">
                                                        <Border Background="{StaticResource LiveAlertBadgeStrongOverlayBrush}" CornerRadius="4" Padding="5,2">
                                                            <TextBlock Text="LIVE" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <!-- This one stays red — it's the actual severity signal, not a status label -->
                                                        <Border Background="{StaticResource LiveAlertBadgeBgBrush}" BorderBrush="{StaticResource LiveAlertAccentBrush}" BorderThickness="1"
                                                                CornerRadius="4" Padding="5,2">
                                                            <TextBlock Text="ALERT" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource LiveAlertTextBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Alert title overlay (center) -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Margin="8" Spacing="4">
                                                        <FontIcon Glyph="&#xE814;" FontSize="{StaticResource FontSizeXLarge}" Foreground="{Binding AlertSeverityBrush, Mode=OneWay}"
                                                                  HorizontalAlignment="Center" Opacity="0.7"/>
                                                        <TextBlock Text="{Binding AlertTitle}"
                                                                   FontSize="{StaticResource FontSizeCompact}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource LiveAlertTextBrush}" TextAlignment="Center"
                                                                   TextWrapping="Wrap" MaxWidth="180" Opacity="0.9"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Alert card footer: action button -->
                                                <Border Grid.Row="2" Background="{StaticResource LiveAlertCardHeaderBgBrush}" Padding="10,8" CornerRadius="0,0,3,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding AlertLocation}"
                                                                       FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource LiveAlertLocationTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                            <TextBlock Text="{Binding AlertTimeDisplay}"
                                                                       FontSize="{StaticResource FontSizeXSmall}" Foreground="{StaticResource DkTextDimBrush}"/>
                                                        </StackPanel>
                                                        <!-- "Xem cảnh báo" button triggers dialog -->
                                                        <Button Grid.Column="1"
                                                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ShowAlertVideoCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{StaticResource LiveAlertActionButtonBrush}" BorderThickness="0"
                                                                CornerRadius="6" Height="30" Padding="10,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE7EF;" FontSize="{StaticResource FontSizeSmall}" Foreground="White"/>
                                                                <TextBlock Text="Xem" FontSize="{StaticResource FontSizeCompact}" FontWeight="SemiBold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Resize grips: sit in the 12px gutter beside/below the card so they
                                     never overlap its buttons. Dragging past half a cell toggles the
                                     span 1↔2 on that axis (LiveVideoPage.xaml.cs handles the drag math;
                                     LiveVideoViewModel.ExpandColumn/Row does the grid-model update). -->
                                <views:CursorGrid Width="12" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0,12"
                                      Background="Transparent"
                                      Visibility="{x:Bind ShowRightGrip, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ManipulationMode="TranslateX"
                                      ManipulationStarted="RightGrip_ManipulationStarted"
                                      ManipulationDelta="RightGrip_ManipulationDelta"
                                      ManipulationCompleted="RightGrip_ManipulationCompleted"
                                      PointerEntered="RightGrip_PointerEntered"
                                      PointerExited="ResizeGrip_PointerExited"
                                      IsTabStop="True" KeyDown="RightGrip_KeyDown"
                                      ToolTipService.ToolTip="Kéo hoặc dùng phím mũi tên trái/phải để mở rộng, thu nhỏ theo chiều ngang"
                                      AutomationProperties.Name="Mở rộng, thu nhỏ theo chiều ngang — dùng phím mũi tên trái/phải">
                                    <Rectangle Width="3" Fill="{StaticResource PrimaryMediumBrush}" Opacity="0.5"
                                               RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,24,0,24">
                                        <Rectangle.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.12"/>
                                        </Rectangle.OpacityTransition>
                                    </Rectangle>
                                </views:CursorGrid>
                                <views:CursorGrid Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,12,0"
                                      Background="Transparent"
                                      Visibility="{x:Bind ShowBottomGrip, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ManipulationMode="TranslateY"
                                      ManipulationStarted="BottomGrip_ManipulationStarted"
                                      ManipulationDelta="BottomGrip_ManipulationDelta"
                                      ManipulationCompleted="BottomGrip_ManipulationCompleted"
                                      PointerEntered="BottomGrip_PointerEntered"
                                      PointerExited="ResizeGrip_PointerExited"
                                      IsTabStop="True" KeyDown="BottomGrip_KeyDown"
                                      ToolTipService.ToolTip="Kéo hoặc dùng phím mũi tên lên/xuống để mở rộng, thu nhỏ theo chiều dọc"
                                      AutomationProperties.Name="Mở rộng, thu nhỏ theo chiều dọc — dùng phím mũi tên lên/xuống">
                                    <Rectangle Height="3" Fill="{StaticResource PrimaryMediumBrush}" Opacity="0.5"
                                               RadiusX="1.5" RadiusY="1.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24,0,24,0">
                                        <Rectangle.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.12"/>
                                        </Rectangle.OpacityTransition>
                                    </Rectangle>
                                </views:CursorGrid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ─── Fullscreen Overlay (YouTube-style) ─── -->
                <!-- AFTER the camera grid → correct z-order. The camera grid is collapsed
                     when this is visible to prevent WebView2 HWND bleed-through. -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Margin="-20"
                      Visibility="{x:Bind ViewModel.IsCameraFocused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="Black">

                    <!-- Video: full bleed -->
                    <controls:CameraVideoControl
                        StreamUrl="{x:Bind ViewModel.FocusedCamera.StreamUrl, Mode=OneWay}"
                        IsOnline="{x:Bind ViewModel.FocusedCamera.IsOnline, Mode=OneWay}"
                        IsStreamEnabled="{x:Bind ViewModel.FocusedCamera.IsStreamEnabled, Mode=OneWay}"
                        SelectedResolution="{x:Bind ViewModel.FocusedCamera.Resolution, Mode=OneWay}"/>

                    <!-- Top floating bar: camera name + LIVE badge -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{StaticResource LiveAlertBadgeStrongOverlayBrush}" Padding="20,12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource LiveAlertBadgeStrongOverlayBrush}" CornerRadius="3" Padding="6,2"
                                    Visibility="{x:Bind ViewModel.FocusedCamera.IsOnline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="LIVE" FontSize="{StaticResource FontSizeXSmall}" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.FocusedCamera.CameraName, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{x:Bind ViewModel.FocusedCamera.CameraId, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource FullscreenCameraIdTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom floating bar: resolution + exit-fullscreen toggle button -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Background="{StaticResource LiveAlertBadgeStrongOverlayBrush}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Độ phân giải:" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource FullscreenLabelTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="FsRes320" Click="FullscreenResolution_Click" Tag="320×240"
                                        Background="{StaticResource FullscreenButtonBgBrush}" BorderThickness="0"
                                        CornerRadius="4" Height="28" Padding="10,0">
                                    <TextBlock Text="SD" FontSize="{StaticResource FontSizeCompact}" Foreground="White"/>
                                </Button>
                                <Button x:Name="FsRes640" Click="FullscreenResolution_Click" Tag="640×480"
                                        Background="{StaticResource FullscreenButtonBgBrush}" BorderThickness="0"
                                        CornerRadius="4" Height="28" Padding="10,0">
                                    <TextBlock Text="VGA" FontSize="{StaticResource FontSizeCompact}" Foreground="White"/>
                                </Button>
                                <Button x:Name="FsRes1280" Click="FullscreenResolution_Click" Tag="1280×720"
                                        Background="{StaticResource FullscreenButtonBgBrush}" BorderThickness="0"
                                        CornerRadius="4" Height="28" Padding="10,0">
                                    <TextBlock Text="HD" FontSize="{StaticResource FontSizeCompact}" Foreground="White"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource FullscreenInfoTextBrush}">
                                    <Run Text="{x:Bind ViewModel.FocusedCamera.Resolution, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{x:Bind ViewModel.FocusedCamera.Fps, Mode=OneWay}"/>
                                    <Run Text=" FPS · "/>
                                    <Run Text="{x:Bind ViewModel.FocusedCamera.BitrateDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Exit fullscreen — paired with the ⛶ expand button on each card -->
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.ExitFocusCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Width="36" Height="36" Padding="0"
                                    ToolTipService.ToolTip="Thu nhỏ">
                                <FontIcon Glyph="&#xE73F;" FontSize="{StaticResource FontSizeMedium}" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
