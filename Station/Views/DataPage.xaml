<Page
    x:Class="Station.Views.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#08111B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ STATUS HEADER ══════════════════ -->
        <Border Grid.Row="0"
                Background="#060D17"
                BorderBrush="#1A3548"
                BorderThickness="0,0,0,1"
                Padding="20,10,20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

                    <!-- System badge -->
                    <Border Background="#0A1E2E" CornerRadius="4" Padding="10,5" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="#00FF88" VerticalAlignment="Center"/>
                            <TextBlock Text="TUNNEL·MONITOR" FontSize="11" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="18" Fill="#1A3548" Margin="0,0,16,0"/>

                    <!-- Sensors stat -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                        <TextBlock Text="SENSORS" FontSize="8" FontFamily="Consolas"
                                   Foreground="#3D6070" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveSensorCountText" Text="0"
                                   FontSize="15" FontFamily="Consolas" FontWeight="Bold"
                                   Foreground="#C0D8E8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Alerts stat -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                        <TextBlock Text="ALERTS" FontSize="8" FontFamily="Consolas"
                                   Foreground="#3D6070" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveAlertCountText" Text="0"
                                   FontSize="15" FontFamily="Consolas" FontWeight="Bold"
                                   Foreground="#C0D8E8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Charts stat -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="CHARTS" FontSize="8" FontFamily="Consolas"
                                   Foreground="#3D6070" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChartCountText" Text="0"
                                   FontSize="15" FontFamily="Consolas" FontWeight="Bold"
                                   Foreground="#C0D8E8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="RefreshData_Click" Padding="12,6" Background="#0D1B2A"
                            BorderBrush="#1A3548" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#7AA8C0"/>
                            <TextBlock Text="REFRESH" FontFamily="Consolas" FontSize="10" Foreground="#7AA8C0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ExportData_Click" Padding="12,6" Background="#0A1E2E"
                            BorderBrush="#1A4A60" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#00E5FF"/>
                            <TextBlock Text="EXPORT" FontFamily="Consolas" FontSize="10" Foreground="#00E5FF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────── SIDEBAR ───────────── -->
            <Border Grid.Column="0"
                    Background="#060D17"
                    BorderBrush="#1A3548"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="14" Spacing="14">

                        <!-- Line filter -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="TUYẾN" FontSize="9" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                            <ComboBox x:Name="LineFilterComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LineFilter_SelectionChanged">
                                <ComboBoxItem Content="Tất cả tuyến" IsSelected="True"/>
                                <ComboBoxItem Content="Tuyến cống Hoàng Quốc Việt"/>
                                <ComboBoxItem Content="Tuyến cống Nghĩa Đô"/>
                                <ComboBoxItem Content="Tuyến cống Xuân La"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Node filter -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="NODE" FontSize="9" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                            <ComboBox x:Name="NodeFilterComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="NodeFilter_SelectionChanged"/>
                        </StackPanel>

                        <!-- Search -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="TÌM KIẾM" FontSize="9" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                            <TextBox x:Name="SearchTextBox"
                                     PlaceholderText="Tên cảm biến..."
                                     HorizontalAlignment="Stretch"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="#1A3548"/>

                        <!-- Sensor types -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="LOẠI CẢM BIẾN" FontSize="9" FontFamily="Consolas"
                                           FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button x:Name="SelectAllButton" Content="ALL" Click="SelectAll_Click"
                                            Padding="6,2" FontSize="9" FontFamily="Consolas" MinHeight="22"
                                            Background="#0D1B2A" BorderBrush="#1A3548" CornerRadius="3"/>
                                    <Button x:Name="ClearAllButton" Content="CLR" Click="ClearAll_Click"
                                            Padding="6,2" FontSize="9" FontFamily="Consolas" MinHeight="22"
                                            Background="#0D1B2A" BorderBrush="#1A3548" CornerRadius="3"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hidden types (Radar + Camera — disabled) -->
                            <Border Visibility="Collapsed">
                                <CheckBox x:Name="ChkRadar" Tag="radar" IsChecked="False"
                                          Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                            </Border>
                            <Border Visibility="Collapsed">
                                <CheckBox x:Name="ChkCamera" Tag="camera" IsChecked="False"
                                          Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                            </Border>

                            <!-- Temperature -->
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="14" Background="#FF4D4D" CornerRadius="2" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkTemperature" Content="NHIỆT ĐỘ"
                                              IsChecked="True" Tag="temperature"
                                              FontSize="11" FontFamily="Consolas"
                                              Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                                </Grid>
                            </Border>

                            <!-- Humidity -->
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="14" Background="#00C8FF" CornerRadius="2" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkHumidity" Content="ĐỘ ẨM"
                                              IsChecked="True" Tag="humidity"
                                              FontSize="11" FontFamily="Consolas"
                                              Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                                </Grid>
                            </Border>

                            <!-- Light -->
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="14" Background="#FFB800" CornerRadius="2" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkLight" Content="ÁNH SÁNG"
                                              IsChecked="True" Tag="light"
                                              FontSize="11" FontFamily="Consolas"
                                              Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                                </Grid>
                            </Border>

                            <!-- Infrared -->
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="14" Background="#FF69B4" CornerRadius="2" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkInfrared" Content="HỒNG NGOẠI"
                                              IsChecked="True" Tag="infrared"
                                              FontSize="11" FontFamily="Consolas"
                                              Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                                </Grid>
                            </Border>

                            <!-- Vibration -->
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="14" Background="#FF8C00" CornerRadius="2" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkVibration" Content="RUNG ĐỘNG"
                                              IsChecked="True" Tag="vibration"
                                              FontSize="11" FontFamily="Consolas"
                                              Checked="ChartType_CheckChanged" Unchecked="ChartType_CheckChanged"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="#1A3548"/>

                        <!-- Display options -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="HIỂN THỊ" FontSize="9" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,10">
                                <StackPanel Spacing="10">
                                    <CheckBox x:Name="ChkShowGrid" Content="Lưới biểu đồ" IsChecked="True"
                                              FontSize="11" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                                    <CheckBox x:Name="ChkShowDataPoints" Content="Điểm dữ liệu" IsChecked="True"
                                              FontSize="11" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                                    <CheckBox x:Name="ChkSmoothLine" Content="Đường mượt" IsChecked="True"
                                              FontSize="11" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                                    <CheckBox x:Name="ChkShowThreshold" Content="Ngưỡng cảnh báo" IsChecked="False"
                                              FontSize="11" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="#1A3548"/>

                        <!-- Layout options -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="BỐ CỤC" FontSize="9" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#3D6070" Margin="2,0,0,0"/>
                            <Border Background="#0D1B2A" CornerRadius="5" Padding="10,10">
                                <StackPanel Spacing="8">
                                    <RadioButton x:Name="LayoutSingle" Content="1 CỘT" GroupName="Layout"
                                                 FontSize="11" FontFamily="Consolas" Checked="LayoutOption_Changed"/>
                                    <RadioButton x:Name="LayoutDouble" Content="2 CỘT" GroupName="Layout"
                                                 FontSize="11" FontFamily="Consolas" IsChecked="True"
                                                 Checked="LayoutOption_Changed"/>
                                    <RadioButton x:Name="LayoutTriple" Content="3 CỘT" GroupName="Layout"
                                                 FontSize="11" FontFamily="Consolas" Checked="LayoutOption_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ───────────── CHARTS AREA ───────────── -->
            <Border Grid.Column="1"
                    Background="#060D17"
                    BorderBrush="#1A3548"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Charts header -->
                    <Border Grid.Row="0" Padding="16,10"
                            BorderBrush="#1A3548" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="DATA·STREAMS" FontSize="11" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#00E5FF"/>
                            <Border Background="#0D1B2A" CornerRadius="10" Padding="8,3">
                                <TextBlock x:Name="ChartCountBadge" Text="—" FontSize="10" FontFamily="Consolas"
                                           Foreground="#3D6070"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable charts grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel x:Name="ChartsPanel" Spacing="14"/>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="16" Visibility="Visible">
                        <Border Width="64" Height="64" Background="#0D1B2A" CornerRadius="32"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="#1A3548"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyStateText" Text="ĐANG KẾT NỐI..."
                                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3D6070" TextAlignment="Center"/>
                            <TextBlock Text="Waiting for backend data stream"
                                       FontSize="10" Foreground="#1A3548" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────────── CAMERA PANEL ───────────── -->
            <Border Grid.Column="2"
                    Background="#060D17"
                    BorderBrush="#1A3548"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Camera header -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="#1A3548" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="CAMERAS" FontSize="11" FontFamily="Consolas"
                                       FontWeight="SemiBold" Foreground="#00E5FF"/>
                            <Border Background="#0D1B2A" CornerRadius="10" Padding="8,3">
                                <TextBlock x:Name="CameraCountText" Text="0" FontSize="10" FontFamily="Consolas"
                                           Foreground="#3D6070"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel x:Name="CameraPanel" Spacing="10"/>
                    </ScrollViewer>

                    <!-- Camera empty state -->
                    <StackPanel x:Name="CameraEmptyState" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="12" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE714;" FontSize="32" Foreground="#1A3548"/>
                        <TextBlock Text="NO CAMERAS" FontFamily="Consolas" FontSize="10"
                                   Foreground="#1A3548" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>




