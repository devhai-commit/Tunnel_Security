<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Station.Views.SnapshotGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE786;" FontSize="24"/>
            <TextBlock Text="Thư viện ảnh camera" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <ComboBox x:Name="CameraCombo" Header="Camera" Width="180"
                      SelectionChanged="CameraCombo_SelectionChanged"/>
            <DatePicker x:Name="FromDatePicker" Header="Từ ngày"/>
            <DatePicker x:Name="ToDatePicker" Header="Đến ngày"/>
            <Button x:Name="SearchButton" Content="Tìm kiếm"
                    VerticalAlignment="Bottom" Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Loading + Gallery -->
        <Grid Grid.Row="2">
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="GalleryScrollViewer">
                <GridView x:Name="SnapshotGrid" SelectionMode="Single"
                          SelectionChanged="SnapshotGrid_SelectionChanged"/>
            </ScrollViewer>
        </Grid>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="PrevButton" Content="← Trước" Click="PrevButton_Click"/>
            <TextBlock Grid.Column="1" x:Name="TotalText"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
            <Button Grid.Column="2" x:Name="NextButton" Content="Tiếp →" Click="NextButton_Click"/>
        </Grid>
    </Grid>
</Page>
