<Page
    x:Class="Station.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.ViewModels"
    Background="{StaticResource DkBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource DkBgBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="Quản lý Thiết bị"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DkTextPrimaryBrush}"/>
                    <TextBlock Text="Quản lý tất cả các thiết bị cảm biến trên hệ thống cống ngầm"
                               FontSize="14"
                               Foreground="{StaticResource DkTextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Đang hoạt động"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DkTextMutedBrush}"
                                       CharacterSpacing="20"/>
                            <TextBlock Text="{x:Bind ViewModel.OnlineDevices, Mode=OneWay}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#22C55E"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Bảo trì"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DkTextMutedBrush}"
                                       CharacterSpacing="20"/>
                            <TextBlock Text="{x:Bind ViewModel.FaultDevices, Mode=OneWay}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ngoại tuyến"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DkTextMutedBrush}"
                                       CharacterSpacing="20"/>
                            <TextBlock Text="{x:Bind ViewModel.OfflineDevices, Mode=OneWay}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Spacing="12"
                            Margin="0,16,0,0" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DkSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                            <TextBlock Text="Xuất báo cáo" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DkPrimaryButtonStyle}"
                            Click="AddDeviceButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Đăng ký thiết bị" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TAB BAR -->
        <Border Grid.Row="1"
                Background="{StaticResource DkSurfaceBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DevicesTabBtn"
                        Click="DevicesTabBtn_Click"
                        Padding="14,7"
                        CornerRadius="8"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="Danh sách thiết bị"/>
                <Button x:Name="JoinRequestsTabBtn"
                        Click="JoinRequestsTabBtn_Click"
                        Padding="14,7"
                        CornerRadius="8"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        FontSize="12"
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Yêu cầu join"/>
                        <Border Background="#334155"
                                CornerRadius="9"
                                Padding="6,1">
                            <TextBlock Text="{x:Bind ViewModel.PendingJoinCount, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- FILTER PANEL (Device tab only) -->
        <Border x:Name="DeviceFilterPanel"
                Grid.Row="2"
                Background="{StaticResource DkSurfaceBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Loại:"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource DkTextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource DkComboBoxStyle}"
                              MinWidth="140"
                              SelectionChanged="TypeFilter_SelectionChanged">
                        <x:String>Tất cả thiết bị</x:String>
                        <x:String>Cảm biến</x:String>
                        <x:String>Camera</x:String>
                        <x:String>Radar</x:String>
                    </ComboBox>
                </StackPanel>

                <Rectangle Width="1" Height="20" Fill="{StaticResource DkBorderBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái:"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource DkTextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="0"
                                Background="{StaticResource DkSurfaceBrush}"
                                BorderBrush="{StaticResource DkBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                        <Button x:Name="StatusAllBtn" Tag="Tất cả"
                                Click="StatusFilter_Tapped"
                                Background="{StaticResource DkBlueBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="12,6"
                                FontSize="12" FontWeight="SemiBold">
                            Tất cả
                        </Button>
                        <Button x:Name="StatusOnlineBtn" Tag="Hoạt động"
                                Click="StatusFilter_Tapped"
                                Background="Transparent"
                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                BorderThickness="0"
                                Padding="12,6"
                                FontSize="12" FontWeight="SemiBold">
                            Hoạt động
                        </Button>
                        <Button x:Name="StatusOfflineBtn" Tag="Ngoại tuyến"
                                Click="StatusFilter_Tapped"
                                Background="Transparent"
                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                BorderThickness="0"
                                Padding="12,6"
                                FontSize="12" FontWeight="SemiBold">
                            Offline
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,0,0,0">
                    <TextBox Style="{StaticResource DkSearchBoxStyle}"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Tìm kiếm ID, vị trí..."
                             MinWidth="280"/>
                    <FontIcon Glyph="&#xE721;" FontSize="14"
                              Foreground="{StaticResource DkTextMutedBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="3">
            <!-- DEVICE LIST TAB -->
            <ScrollViewer x:Name="DeviceTabContent"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,16">
                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="ID / Tên thiết bị"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               CharacterSpacing="20" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Loại"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               CharacterSpacing="20" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Vị trí địa lý"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               CharacterSpacing="20" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Trạng thái"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               CharacterSpacing="20" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Cập nhật lần cuối"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               CharacterSpacing="20" VerticalAlignment="Center"
                                               HorizontalTextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ItemsRepeater Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.FilteredNodes, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource DkBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,14"
                                                PointerEntered="TableRow_PointerEntered"
                                                PointerExited="TableRow_PointerExited"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="3" Height="16"
                                                                Background="{Binding StatusColor}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NodeName}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="{StaticResource DkTextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding NodeId}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource DkTextDimBrush}"
                                                                       FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                           Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE968;" FontSize="12"
                                                             Foreground="{StaticResource DkTextDimBrush}"/>
                                                    <TextBlock Text="{Binding DeviceType}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource DkTextSecondaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Location}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource DkTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="3"
                                                        Background="{Binding StatusBackgroundColor}"
                                                        BorderBrush="{Binding StatusColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding StatusColor}"
                                                               CharacterSpacing="20"/>
                                                </Border>

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding LastTelemetry}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource DkTextDimBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalTextAlignment="Right"
                                                           FontFamily="Consolas"/>

                                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                           Spacing="4" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center">
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chi tiết"
                                                            Tag="{Binding}"
                                                            Click="ViewDetails_Click">
                                                        <FontIcon Glyph="&#xE71B;" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chỉnh sửa"
                                                            Tag="{Binding}"
                                                            Click="EditButton_Click">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- JOIN REQUEST TAB -->
            <ScrollViewer x:Name="JoinTabContent"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid Margin="24,16">
                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#20232A"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="●" Foreground="#D1D5DB" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="DANH SÁCH YÊU CẦU CHỜ XỬ LÝ"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="20"
                                                   Foreground="#D1D5DB"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.PendingJoinLastUpdatedDisplay, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A1A1AA"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="#17191F"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THIẾT BỊ / LOẠI" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock Grid.Column="1" Text="PHIÊN BẢN FW" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock Grid.Column="2" Text="HARDWARE ID" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock Grid.Column="3" Text="ĐỊA CHỈ MAC/IP" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock Grid.Column="4" Text="THAO TÁC" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA"/>
                                </Grid>
                            </Border>

                            <ItemsRepeater Grid.Row="2"
                                          ItemsSource="{x:Bind ViewModel.PendingJoinRequests, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#15171D"
                                                BorderBrush="{StaticResource DkBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,14">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            Spacing="10">
                                                    <Border Width="28" Height="28"
                                                            Background="#2B313C"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE968;"
                                                                  FontSize="12"
                                                                  Foreground="#9CA3AF"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DeviceName}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E5E7EB"
                                                                   FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding DeviceType}"
                                                                   FontSize="12"
                                                                   Foreground="#A1A1AA"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FirmwareDisplay}"
                                                           FontSize="12"
                                                           Foreground="#D4D4D8"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding HardwareIdHex}"
                                                           FontSize="12"
                                                           Foreground="#D4D4D8"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IpAddressDisplay}"
                                                               FontSize="12"
                                                               Foreground="#A1A1AA"/>
                                                    <TextBlock Text="{Binding MacAddressDisplay}"
                                                               FontSize="12"
                                                               Foreground="#71717A"
                                                               FontFamily="Consolas"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4"
                                                            Orientation="Horizontal"
                                                            Spacing="10"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding RejectCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Background="Transparent"
                                                            Foreground="#FCA5A5"
                                                            BorderBrush="#FCA5A5"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="14,8"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Content="Từ chối"/>
                                                    <Button Command="{Binding ApproveCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Background="#D1D5DB"
                                                            Foreground="#111827"
                                                            BorderBrush="#D1D5DB"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="14,8"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Content="Phê duyệt"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Border Grid.Row="3"
                                    Background="#17191F"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind ViewModel.PendingJoinFooterText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#A1A1AA"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Style="{StaticResource DkIconButtonStyle}" IsEnabled="False">
                                            <FontIcon Glyph="&#xE76B;" FontSize="10"/>
                                        </Button>
                                        <Button Width="28" Height="28"
                                                Background="#334155"
                                                BorderThickness="0"
                                                Foreground="White"
                                                CornerRadius="6"
                                                Content="1"/>
                                        <Button Width="28" Height="28"
                                                Background="Transparent"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                Foreground="#CBD5E1"
                                                CornerRadius="6"
                                                Content="2"/>
                                        <Button Width="28" Height="28"
                                                Background="Transparent"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                Foreground="#CBD5E1"
                                                CornerRadius="6"
                                                Content="3"/>
                                        <Button Style="{StaticResource DkIconButtonStyle}" IsEnabled="False">
                                            <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
