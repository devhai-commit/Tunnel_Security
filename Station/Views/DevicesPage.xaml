<Page
    x:Class="Station.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.ViewModels"
    Background="{StaticResource DkBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DkBgBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title + tab switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                    <TextBlock Text="QUẢN LÝ THIẾT BỊ" FontSize="{StaticResource FontSizeNormal}" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="{StaticResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource DkBorderBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="0"
                                Background="{StaticResource DkBgBrush}"
                                BorderBrush="{StaticResource DkBorderBrush}"
                                BorderThickness="1"
                                Padding="2">
                        <Button x:Name="DevicesTabBtn"
                                Click="DevicesTabBtn_Click"
                                Padding="14,6"
                                CornerRadius="0"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Content="Danh sách thiết bị"/>
                        <Button x:Name="JoinRequestsTabBtn"
                                Click="JoinRequestsTabBtn_Click"
                                Padding="14,6"
                                CornerRadius="0"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="Yêu cầu join"/>
                                <Border Background="{StaticResource MonitoringJoinBadgeBgBrush}"
                                        BorderBrush="{StaticResource MonitoringJoinBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="7,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.PendingJoinCount, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeXSmall}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MonitoringJoinBorderBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource DkSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74E;" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Xuất báo cáo" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DkPrimaryButtonStyle}"
                            Click="AddDeviceButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeBody}"/>
                            <TextBlock Text="Đăng ký thiết bị" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             STATS CARDS
        ══════════════════════════════════════════════════════ -->
        <Border x:Name="StatsPanel"
                Grid.Row="1"
                Background="{StaticResource DkBgBrush}"
                Margin="24,16,24,16"
                Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng thiết bị -->
                <Border Grid.Column="0"
                        Background="{StaticResource DkSurfaceBrush}"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        Padding="20,20" Margin="0,0,8,0">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE968;" FontSize="{StaticResource FontSizeTitle}"
                                      Foreground="{StaticResource DkBlueBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Tổng thiết bị" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource DkTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalDevices, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                   Foreground="{StaticResource DkTextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <!-- Đang hoạt động -->
                <Border Grid.Column="1"
                        Background="{StaticResource DkSurfaceBrush}"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        Padding="20,20" Margin="8,0,8,0">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource FontSizeTitle}"
                                      Foreground="{StaticResource DkGreenBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Đang hoạt động" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource DkTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OnlineDevices, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                   Foreground="{StaticResource DkGreenBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <!-- Cảnh báo -->
                <Border Grid.Column="2"
                        Background="{StaticResource DkSurfaceBrush}"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        Padding="20,20" Margin="8,0,8,0">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource FontSizeTitle}"
                                      Foreground="{StaticResource DkYellowBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Cảnh báo" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource DkTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.FaultDevices, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                   Foreground="{StaticResource DkYellowBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>

                <!-- Ngoại tuyến -->
                <Border Grid.Column="3"
                        Background="{StaticResource DkSurfaceBrush}"
                        BorderBrush="{StaticResource DkBorderBrush}"
                        BorderThickness="1"
                        Padding="20,20" Margin="8,0,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE783;" FontSize="{StaticResource FontSizeTitle}"
                                      Foreground="{StaticResource DkGrayBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Ngoại tuyến" FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource DkTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OfflineDevices, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                   Foreground="{StaticResource DkGrayBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             FILTER PANEL  (device tab only)
        ══════════════════════════════════════════════════════ -->
        <Border x:Name="DeviceFilterPanel"
                Grid.Row="2"
                Background="{StaticResource DkSurfaceBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="1"
                Padding="0,16">
            <Grid Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Type filter -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Loại:"
                               FontFamily="Consolas"
                               FontSize="{StaticResource FontSizeCompact}" FontWeight="SemiBold"
                               Foreground="{StaticResource DkTextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource DkComboBoxStyle}"
                              MinWidth="132"
                              SelectionChanged="TypeFilter_SelectionChanged">
                        <x:String>Tất cả thiết bị</x:String>
                        <x:String>Cảm biến</x:String>
                        <x:String>Camera</x:String>
                        <x:String>Radar</x:String>
                    </ComboBox>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="20"
                           Fill="{StaticResource DkBorderBrush}"
                           VerticalAlignment="Center" Margin="14,0"/>

                <!-- Status segmented filter -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái:"
                               FontFamily="Consolas"
                               FontSize="{StaticResource FontSizeCompact}" FontWeight="SemiBold"
                               Foreground="{StaticResource DkTextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="0"
                                Background="{StaticResource DkBgBrush}"
                                BorderBrush="{StaticResource DkBorderBrush}"
                                BorderThickness="1"
                                Padding="2">
                        <Button x:Name="StatusAllBtn" Tag="Tất cả"
                                Click="StatusFilter_Tapped"
                                Background="{StaticResource DkBlueBgBrush}"
                                Foreground="{StaticResource DkBlueLightBrush}"
                                BorderBrush="{StaticResource DkBlueBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="11,5"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold">
                            Tất cả
                        </Button>
                        <Button x:Name="StatusOnlineBtn" Tag="Hoạt động"
                                Click="StatusFilter_Tapped"
                                Background="Transparent"
                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="11,5"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSizeSmall}">
                            Hoạt động
                        </Button>
                        <Button x:Name="StatusOfflineBtn" Tag="Ngoại tuyến"
                                Click="StatusFilter_Tapped"
                                Background="Transparent"
                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="11,5"
                                FontFamily="Consolas"
                                FontSize="{StaticResource FontSizeSmall}">
                            Ngoại tuyến
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="20"
                           Fill="{StaticResource DkBorderBrush}"
                           VerticalAlignment="Center" Margin="14,0"/>

                <!-- Search box -->
                <Grid Grid.Column="4">
                    <TextBox Style="{StaticResource DkSearchBoxStyle}"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Tìm kiếm ID, tên, vị trí..."
                             HorizontalAlignment="Stretch"/>
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource FontSizeBody}"
                              Foreground="{StaticResource DkTextMutedBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             CONTENT  (device list / join requests)
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- DEVICE LIST TAB -->
            <Grid x:Name="DeviceTabContent" Margin="24,16,24,24" VerticalAlignment="Top">
                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column headers -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="ID / TÊN THIẾT BỊ"
                                               Style="{StaticResource DkLabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="LOẠI"
                                               Style="{StaticResource DkLabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="VỊ TRÍ"
                                               Style="{StaticResource DkLabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="TRẠNG THÁI"
                                               Style="{StaticResource DkLabelStyle}"
                                               HorizontalTextAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="THAO TÁC"
                                               Style="{StaticResource DkLabelStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalTextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Device rows -->
                            <ItemsRepeater Grid.Row="1"
                                           ItemsSource="{x:Bind ViewModel.PagedFilteredNodes, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource DkBorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                MinHeight="64"
                                                Padding="24,14"
                                                PointerEntered="TableRow_PointerEntered"
                                                PointerExited="TableRow_PointerExited"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Node name + ID -->
                                                <StackPanel Grid.Column="0"
                                                            Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NodeName}"
                                                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DkTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding NodeId}"
                                                               FontSize="{StaticResource FontSizeXSmall}"
                                                               Foreground="{StaticResource DkTextDimBrush}"
                                                               FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Device type chip — pill -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource DkBgBrush}"
                                                        BorderBrush="{StaticResource DkBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        MaxWidth="240">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE968;" FontSize="{StaticResource FontSizeCompact}"
                                                                  Foreground="{StaticResource DkTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding DeviceType}"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{StaticResource DkTextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Location -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE81D;" FontSize="{StaticResource FontSizeCompact}"
                                                              Foreground="{StaticResource DkTextMutedBrush}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Location}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource DkTextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Status badge — pill with dot -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding StatusBackgroundColor}"
                                                        BorderBrush="{Binding StatusColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{Binding StatusColor}"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{StaticResource FontSizeCompact}" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusColor}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Row actions — centered -->
                                                <StackPanel Grid.Column="4"
                                                            Orientation="Horizontal" Spacing="4"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chi tiết"
                                                            Tag="{Binding}"
                                                            Click="ViewDetails_Click">
                                                        <FontIcon Glyph="&#xE71B;" FontSize="{StaticResource FontSizeSmall}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chỉnh sửa"
                                                            Tag="{Binding}"
                                                            Click="EditButton_Click">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSizeSmall}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Xóa thiết bị"
                                                            Tag="{Binding}"
                                                            Click="DeleteButton_Click">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeSmall}"
                                                                  Foreground="{StaticResource DkRedBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Table footer -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind ViewModel.PageFooterText, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Style="{StaticResource DkIconButtonStyle}"
                                                Command="{x:Bind ViewModel.PrevPageCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanGoPrevPage, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource FontSizeCompact}"/>
                                        </Button>
                                        <Button Width="28" Height="28"
                                                Background="{StaticResource DkBlueDarkBrush}"
                                                BorderThickness="0"
                                                Foreground="{StaticResource DkTextPrimaryBrush}"
                                                CornerRadius="0"
                                                FontFamily="Consolas"
                                                FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                Content="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                                        <Button Style="{StaticResource DkIconButtonStyle}"
                                                Command="{x:Bind ViewModel.NextPageCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanGoNextPage, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource FontSizeCompact}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
            </Grid>

            <!-- JOIN REQUESTS TAB -->
            <ScrollViewer x:Name="JoinTabContent"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid Margin="24,16,24,24">
                    <Border Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}"
                            BorderThickness="1"
>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                            Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="9"
                                                VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="{StaticResource DkYellowBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="DANH SÁCH YÊU CẦU CHỜ XỬ LÝ"
                                                   Style="{StaticResource DkLabelStyle}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.PendingJoinLastUpdatedDisplay, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Column headers -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THIẾT BỊ / LOẠI"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="PHIÊN BẢN FW"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="HARDWARE ID"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="ĐỊA CHỈ MAC / IP"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="NODE ID"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="THAO TÁC"
                                               Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Join request rows -->
                            <ItemsRepeater Grid.Row="2"
                                           ItemsSource="{x:Bind ViewModel.PendingJoinRequests, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource DkBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="190"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Device name + type -->
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal" Spacing="10"
                                                            VerticalAlignment="Center">
                                                    <Border Width="32" Height="32"
                                                            Background="{StaticResource DkBorderBrush}"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE968;"
                                                                  FontSize="{StaticResource FontSizeNormal}"
                                                                  Foreground="{StaticResource DkTextMutedBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding DeviceName}"
                                                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DkTextPrimaryBrush}"
                                                                   FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding DeviceType}"
                                                                   FontSize="{StaticResource FontSizeCompact}"
                                                                   Foreground="{StaticResource DkTextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Firmware -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FirmwareDisplay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource DkTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>

                                                <!-- Hardware ID -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding HardwareIdHex}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource DkTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"/>

                                                <!-- MAC / IP -->
                                                <StackPanel Grid.Column="3"
                                                            VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding IpAddressDisplay}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource DkTextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding MacAddressDisplay}"
                                                               FontSize="{StaticResource FontSizeXSmall}"
                                                               Foreground="{StaticResource DkTextMutedBrush}"
                                                               FontFamily="Consolas"/>
                                                </StackPanel>

                                                <!-- Node Byte ID input -->
                                                <TextBox Grid.Column="4"
                                                         Text="{Binding NodeByteIdInput, Mode=TwoWay}"
                                                         PlaceholderText="ID"
                                                         FontSize="{StaticResource FontSizeSmall}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         Style="{StaticResource DkSearchBoxStyle}"/>

                                                <!-- Reject + Approve -->
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding RejectCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource DkRedBrush}"
                                                            BorderBrush="{StaticResource DkRedBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="13,7"
                                                            FontFamily="Consolas"
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            FontWeight="SemiBold"
                                                            Content="Từ chối"/>
                                                    <Button Command="{Binding ApproveCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Style="{StaticResource DkPrimaryButtonStyle}"
                                                            Padding="13,7"
                                                            FontFamily="Consolas"
                                                            Content="Phê duyệt"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Footer / pagination -->
                            <Border Grid.Row="3"
                                    Background="{StaticResource DkBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="24,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind ViewModel.PendingJoinFooterText, Mode=OneWay}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{StaticResource DkTextMutedBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Style="{StaticResource DkIconButtonStyle}" IsEnabled="False">
                                            <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource FontSizeXSmall}"/>
                                        </Button>
                                        <Button Width="26" Height="26"
                                                Background="{StaticResource DkBlueBrush}"
                                                BorderThickness="0"
                                                Foreground="{StaticResource DkTextPrimaryBrush}"
                                                CornerRadius="0"
                                                FontFamily="Consolas"
                                                FontSize="{StaticResource FontSizeCompact}"
                                                Content="1"/>
                                        <Button Width="26" Height="26"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource DkBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                                CornerRadius="0"
                                                FontFamily="Consolas"
                                                FontSize="{StaticResource FontSizeCompact}"
                                                Content="2"/>
                                        <Button Width="26" Height="26"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource DkBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource DkTextSecondaryBrush}"
                                                CornerRadius="0"
                                                FontFamily="Consolas"
                                                FontSize="{StaticResource FontSizeCompact}"
                                                Content="3"/>
                                        <Button Style="{StaticResource DkIconButtonStyle}" IsEnabled="False">
                                            <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource FontSizeXSmall}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
