<Page
    x:Class="Station.Views.AnalyticsReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:views="using:Station.Views"
    mc:Ignorable="d">

    <!-- =================== RESOURCES =================== -->
    <Page.Resources>
        <Style x:Key="AnalyticsKpiCardBorderStyle" TargetType="Border">
            <!-- Nền hơi sáng hơn background chung để nhìn nổi lên -->
            <Setter Property="Background" Value="{StaticResource AnalyticsKpiBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,4,12,16"/>
        </Style>

        <SolidColorBrush x:Key="AnalyticsKpiBackgroundBrush" Color="{ThemeResource BackgroundPrimary}"/>
        <SolidColorBrush x:Key="AnalyticsKpiBorderBrush"     Color="{ThemeResource BorderLight}"/>

        <!-- Nền & card: đồng bộ với MonitoringDashboard -->
        <SolidColorBrush x:Key="AnalyticsPageBackgroundBrush" Color="{ThemeResource BackgroundSecondary}"/>
        <SolidColorBrush x:Key="AnalyticsCardBackgroundBrush" Color="{ThemeResource BackgroundPrimary}"/>
        <SolidColorBrush x:Key="AnalyticsCardBorderBrush" Color="{ThemeResource BorderLight}"/>
        <SolidColorBrush x:Key="AnalyticsTextSecondaryBrush" Color="{ThemeResource TextSecondary}"/>

        <!-- Màu cho nút lọc (nút xanh trên nền tối) -->
        <SolidColorBrush x:Key="FilterBlueBrush"                  Color="#4F8DFF"/>
        <SolidColorBrush x:Key="FilterBlueHoverBrush"             Color="#3F7DED"/>
        <SolidColorBrush x:Key="FilterBluePressedBrush"           Color="#305FCC"/>
        <SolidColorBrush x:Key="FilterDropDownBackgroundBrush"    Color="{ThemeResource BackgroundPrimary}"/>
        <SolidColorBrush x:Key="FilterDropDownItemHoverBrush"     Color="{ThemeResource BackgroundSecondary}"/>
        <SolidColorBrush x:Key="FilterDropDownItemSelectedBrush"  Color="#1D4ED8"/>

        <!-- Override brush mặc định của ComboBox chỉ trong page này -->
        <SolidColorBrush x:Key="ComboBoxBackground"                  Color="#4F8DFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"       Color="#3F7DED"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed"           Color="#305FCC"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush"                 Color="#4F8DFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver"      Color="#3F7DED"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"          Color="#305FCC"/>
        <SolidColorBrush x:Key="ComboBoxForeground"                  Color="White"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBackground"          Color="{ThemeResource BackgroundPrimary}"/>

        <!-- Dropdown items -->
        <SolidColorBrush x:Key="ComboBoxItemForeground"                        Color="{ThemeResource TextPrimary}"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"            Color="{ThemeResource BackgroundSecondary}"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"               Color="#1D4ED8"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver"    Color="#1E40AF"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected"               Color="White"/>

        <!-- Style chung cho các ComboBox bộ lọc (hình pill xanh) -->
        <Style x:Key="AnalyticsFilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="150"/>
            <!-- không đụng Template, dùng template mặc định + brush override -->
        </Style>

    </Page.Resources>

    <!-- =================== PAGE LAYOUT =================== -->
    <Grid Background="{StaticResource AnalyticsPageBackgroundBrush}"
          Padding="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========= TOP BAR: Title + Export ========= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BackButton_Click"
                        Margin="0,0,12,0"
                        Style="{StaticResource NavigationBackButtonNormalStyle}">
                    <FontIcon Glyph="&#xE72B;"/>
                </Button>

                <StackPanel>
                    <TextBlock Text="Phân tích và Báo cáo"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <TextBlock Text="Trạm Nghĩa Đô · TRM-HN-001"
                               FontSize="13"
                               Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- nút export -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Chuyển đổi chế độ sáng/tối">
                    <Grid>
                        <FontIcon x:Name="MoonIcon"
                                  Glyph="&#xE708;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <FontIcon x:Name="SunIcon"
                                  Glyph="&#xE706;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextPrimaryBrush}"
                                  Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button Content="Xuất PDF"
                        Click="ExportPdf_Click"/>
                <Button Content="Xuất Excel"
                        Click="ExportExcel_Click"/>
            </StackPanel>
        </Grid>

        <!-- =================== MAIN CONTENT =================== -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- H0: KPI; H1: Filter; H2: dashboard overview charts; H3: realtime analysis; H4: heatmap; H5: history + top node -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="330"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="360"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== KPI CARDS ===== -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng số cảnh báo -->
                <Border Grid.Column="0"
        Style="{StaticResource AnalyticsKpiCardBorderStyle}">
                    <StackPanel Margin="18">
                        <TextBlock Text="Tổng số cảnh báo"
                   FontSize="13"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                        <TextBlock x:Name="TotalAlertsValue"
                   Text="0"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextPrimaryBrush}"
                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="TotalAlertsChange"
                   Text="+0% so với kỳ trước"
                   FontSize="11"
                   Foreground="#FF35C97F"
                   Margin="0,4,0,0"/>

                        <TextBlock x:Name="ProcessedSummaryText"
                   Text="Đã xử lý: 0 (0%)"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="OpenSummaryText"
                   Text="Đang mở: 0 (0%)"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>


                <!-- Cảnh báo nghiêm trọng -->
                <Border Grid.Column="1"
        Style="{StaticResource AnalyticsKpiCardBorderStyle}">
                    <StackPanel Margin="18">
                        <TextBlock Text="Cảnh báo nghiêm trọng"
                   FontSize="13"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                        <TextBlock x:Name="SevereAlertsValue"
                   Text="9"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextPrimaryBrush}"
                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="SevereAlertsChange"
                   Text="-3 so với kỳ trước"
                   FontSize="11"
                   Foreground="#FF35C97F"
                   Margin="0,4,0,0"/>

                        <TextBlock x:Name="LineCountText"
                   Text="Số tuyến có cảnh báo: 0"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>



                <!-- Node lỗi nhiều nhất -->
                <Border Grid.Column="2"
        Style="{StaticResource AnalyticsKpiCardBorderStyle}">
                    <StackPanel Margin="18">
                        <TextBlock Text="Điểm nóng hiện tại"
                   FontSize="13"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                        <TextBlock x:Name="HotspotNodeText"
                   Text="-"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextPrimaryBrush}"
                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="HotspotNodeDetailText"
                   Text="Chưa có dữ liệu"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>



                <!-- Thiết bị hoạt động -->
                <Border Grid.Column="3"
        Style="{StaticResource AnalyticsKpiCardBorderStyle}">
                    <StackPanel Margin="18">
                        <TextBlock Text="Thiết bị đang online"
                   FontSize="13"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                        <TextBlock x:Name="OnlineDeviceText"
                   Text="39 / 45"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{ThemeResource TextPrimaryBrush}"
                   Margin="0,6,0,0"/>
                        <TextBlock Text="86% hoạt động"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>

                        <TextBlock x:Name="AvgHandleTimeText"
                   Text="Thời gian xử lý TB: -"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="RealtimeSampleText"
                   Text="Snapshot: chờ dữ liệu"
                   FontSize="11"
                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>


            </Grid>

            <!-- ===== FILTER BAR (nút xanh) ===== -->
            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="8"
                        Margin="0,0,0,12">

                <!-- Mốc thời gian -->
                <ComboBox x:Name="PeriodFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          SelectionChanged="Filter_SelectionChanged"/>

                <!-- Tuyến -->
                <ComboBox x:Name="LineFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          SelectionChanged="Filter_SelectionChanged"/>

                <!-- Nút -->
                <ComboBox x:Name="NodeFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          MinWidth="135"
                          SelectionChanged="Filter_SelectionChanged"/>

                <!-- Camera -->
                <ComboBox x:Name="CameraFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          MinWidth="145"
                          SelectionChanged="Filter_SelectionChanged"/>

                <!-- Mức cảnh báo -->
                <ComboBox x:Name="SeverityFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          SelectionChanged="Filter_SelectionChanged"/>

                <!-- Trạng thái xử lý -->
                <ComboBox x:Name="StatusFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>

            <!-- ===== HÀNG 2: 2 BIỂU ĐỒ ĐỒNG BỘ VỚI CARD NGOÀI DASHBOARD ===== -->
            <Border Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,12,12"
                    Background="{StaticResource AnalyticsCardBackgroundBrush}"
                    BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Margin="16">
                    <TextBlock Text="Phân tích &amp; thống kê - xu hướng cảnh báo"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Tổng số, nghiêm trọng, cảnh báo và các ngưỡng vận hành giống card ngoài dashboard"
                               FontSize="11"
                               Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>

                    <lvc:CartesianChart Margin="0,12,0,0"
                                        Height="185"
                                        Series="{x:Bind OverviewTrendSeries}"
                                        XAxes="{x:Bind OverviewTrendAxes}"
                                        YAxes="{x:Bind OverviewTrendYAxes}"
                                        LegendPosition="Hidden"
                                        TooltipPosition="Top"
                                        Background="Transparent"/>

                    <StackPanel Margin="0,10,0,0"
                                Spacing="8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngưỡng nghiêm trọng"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#FBBF24" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngưỡng cảnh báo"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#34D399" VerticalAlignment="Center"/>
                                <TextBlock Text="Giá trị kỳ vọng"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#3B82F6" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng số"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Text="Nghiêm trọng"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="11" Height="11" Fill="#F97316" VerticalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Background="{StaticResource AnalyticsCardBackgroundBrush}"
                    BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Margin="16">
                    <TextBlock Text="Top nguồn phát sinh cảnh báo"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Các sensor/camera/radar có số cảnh báo cao nhất trong bộ lọc hiện tại"
                               FontSize="11"
                               Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>

                    <ItemsRepeater x:Name="TopSourceRepeater"
                                   Margin="0,14,0,0">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="views:TopSourceStat">
                                <Grid Height="26"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding SourceCode}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                    <Grid Grid.Column="1"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch">
                                        <Border Background="#111827"
                                                CornerRadius="4"/>
                                        <Border Width="{Binding BarWidth}"
                                                Background="{Binding BarBrush}"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"/>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AlertCount}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ===== HÀNG 3: NHỊP CẢNH BÁO + PHÂN BỔ MỨC ĐỘ ===== -->
            <Grid Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="{StaticResource AnalyticsCardBackgroundBrush}"
                        BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nhịp cảnh báo 12 phút gần nhất"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="RealtimeWindowText"
                                           Text="Số cảnh báo mới/phút, tách rõ rủi ro cao và cảnh báo chưa đóng"
                                           FontSize="11"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    CornerRadius="12"
                                    Background="#172554"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="RealtimeStatusText"
                                           Text="SNAPSHOT"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#93C5FD"/>
                            </Border>
                        </Grid>

                        <lvc:CartesianChart Margin="0,14,0,0"
                                            Height="190"
                                            Series="{x:Bind RealtimeTrendSeries}"
                                            XAxes="{x:Bind RealtimeAxes}"
                                            YAxes="{x:Bind RealtimeYAxes}"
                                            Background="Transparent"
                                            TooltipPosition="Top"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource AnalyticsCardBackgroundBrush}"
                        BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Margin="16">
                        <TextBlock Text="Cơ cấu mức độ cảnh báo"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SeverityMixText"
                                   Text="Tỷ trọng nghiêm trọng/cao/trung bình/thấp"
                                   FontSize="11"
                                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                   Margin="0,3,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <lvc:PieChart Grid.Column="0"
                                          Height="190"
                                          Series="{x:Bind SeverityDonutSeries}"
                                          InitialRotation="-90"
                                          LegendPosition="Hidden"
                                          TooltipPosition="Top"
                                          Background="Transparent"/>

                            <StackPanel Grid.Column="1"
                                        MinWidth="150"
                                        Margin="18,18,0,0"
                                        Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeverityCriticalLegendText"
                                               Text="Nghiêm trọng"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#F97316" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeverityHighLegendText"
                                               Text="Cao"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#EAB308" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeverityMediumLegendText"
                                               Text="Trung bình"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeverityLowLegendText"
                                               Text="Thấp"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== HÀNG 4: HEATMAP NGÀY / GIỜ ===== -->
            <Border Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,12"
                    Background="{StaticResource AnalyticsCardBackgroundBrush}"
                    BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bản đồ nhịp cảnh báo theo ngày / giờ"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="Màu từng ô được tính theo số cảnh báo tại chính giao điểm ngày-giờ đó; màu chuyển từ xanh sang hồng khi mật độ cảnh báo tăng"
                                       FontSize="11"
                                       Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,10,0,0">
                                <TextBlock Text="Ít"
                                           FontSize="11"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Width="160"
                                        Height="8"
                                        CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#60A5FA" Offset="0"/>
                                            <GradientStop Color="#818CF8" Offset="0.34"/>
                                            <GradientStop Color="#C084FC" Offset="0.66"/>
                                            <GradientStop Color="#FB7185" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Nhiều"
                                           FontSize="11"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PeakHourText"
                                   Grid.Column="1"
                                   Text="-"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FF35C97F"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,8">
                            <TextBlock Text="Tổng theo giờ"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                            <TextBlock x:Name="HeatmapTotalText"
                                       Text="0 cảnh báo"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None"/>
                        </StackPanel>

                        <ItemsRepeater x:Name="HeatmapHourBarsRepeater"
                                       Grid.Row="0"
                                       Grid.Column="1">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24"
                                                   MinColumnSpacing="3"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:HourBucketStat">
                                    <Grid Height="76"
                                          ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border Width="12"
                                                Height="{Binding BarHeight}"
                                                Background="{Binding Brush}"
                                                CornerRadius="3,3,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Opacity="{Binding Opacity}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Ngày | Giờ"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <ItemsRepeater x:Name="HeatmapHourLabelsRepeater"
                                       Grid.Row="1"
                                       Grid.Column="1">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24"
                                                   MinColumnSpacing="3"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AnalyticsTextSecondaryBrush}"
                                               FontSize="11"/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsRepeater x:Name="HeatmapDayBarsRepeater"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,8,12,0">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:DayBucketStat">
                                    <Grid Height="25"
                                          ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border Width="{Binding BarWidth}"
                                                Background="{Binding Brush}"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Height="18"
                                                Opacity="{Binding Opacity}"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsRepeater x:Name="HeatmapRepeater"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,8,0,0">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24"
                                                   MinColumnSpacing="0"
                                                   MinRowSpacing="0"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:HeatmapCell">
                                    <Grid Height="25"
                                          ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border BorderBrush="{Binding GridLineBrush}"
                                                BorderThickness="0.5"
                                                Background="{Binding CellOverlayBrush}"
                                                Opacity="{Binding CellOpacity}"/>
                                        <Border BorderBrush="{Binding HighlightBrush}"
                                                BorderThickness="{Binding HighlightThickness}"
                                                Opacity="0.45"/>
                                        <TextBlock Text="{Binding CountText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding CountForeground}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== HÀNG 5: LỊCH SỬ CẢNH BÁO ===== -->
            <!-- Lịch sử cảnh báo -->
            <Border Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    Background="{StaticResource AnalyticsCardBackgroundBrush}"
                    BorderBrush="{StaticResource AnalyticsCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dữ liệu lịch sử cảnh báo"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextPrimaryBrush}"/>

                        <Button Grid.Column="1"
                                Content="Lọc nâng cao"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView x:Name="HistoryGrid"
                              Margin="0,12,0,0"
                              Height="360"
                              MaxHeight="360"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.Header>
                            <Grid Padding="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Thời gian" FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Tuyến"     FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="Nút"       FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="Loại cảnh báo" FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="Mức độ"    FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="5" Text="Trạng thái xử lý" FontWeight="SemiBold"
                                           Foreground="{StaticResource AnalyticsTextSecondaryBrush}"/>
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Line}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Node}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AlertType}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Severity}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Status}"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
