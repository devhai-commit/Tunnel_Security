<Page
    x:Class="Station.Views.SensorChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DkBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DkBgBrush}"
                BorderBrush="{StaticResource DkBorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: app label + connection / counters pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                    <TextBlock Text="GIÁM SÁT CẢM BIẾN" FontSize="{StaticResource FontSizeNormal}" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="{StaticResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource DkBorderBrush}"/>

                    <Border Background="{StaticResource DkSurfaceBrush}" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="ConnectionDot" Width="6" Height="6"
                                         Fill="{StaticResource DkConnectionOfflineBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectionText" Text="CONNECTING..."
                                           FontSize="{StaticResource FontSizeCompact}" FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource DkConnectionOfflineBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="14" Fill="{StaticResource DkBorderBrush}"/>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="SENSORS" FontSize="{StaticResource FontSizeTiny}" FontFamily="Consolas"
                                           Foreground="{StaticResource DkTextDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SensorCountText" Text="0" FontSize="{StaticResource FontSizeSubtitle}"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           Foreground="{StaticResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="UPDATES" FontSize="{StaticResource FontSizeTiny}" FontFamily="Consolas"
                                           Foreground="{StaticResource DkTextDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalUpdatesText" Text="0" FontSize="{StaticResource FontSizeSubtitle}"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           Foreground="{StaticResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="ClearHistory_Click" Padding="12,6"
                            Background="{StaticResource DkSurfaceBrush}"
                            BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource DkTextMutedBrush}"/>
                            <TextBlock Text="CLEAR" FontFamily="Consolas" FontSize="{StaticResource FontSizeXSmall}"
                                       Foreground="{StaticResource DkTextMutedBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DkIconButtonStyle}"
                            ToolTipService.ToolTip="Thông báo">
                        <FontIcon Glyph="&#xE7E7;" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource DkTextMutedBrush}"/>
                    </Button>
                    <Button Style="{StaticResource DkIconButtonStyle}"
                            ToolTipService.ToolTip="Cấu hình">
                        <FontIcon Glyph="&#xE713;" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource DkTextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── SIDEBAR ─────────── -->
            <Border Grid.Column="0" Background="{StaticResource DkBgBrush}"
                    BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section: Bố cục -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,4">
                        <TextBlock Text="BỐ CỤC" FontSize="{StaticResource FontSizeCaption}" FontFamily="Consolas"
                                   FontWeight="SemiBold" Foreground="{StaticResource DkTextDimBrush}"
                                   CharacterSpacing="80" Margin="18,0,18,10"/>

                        <Border x:Name="LayoutOpt1" Tag="1" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="18,9"
                                Background="Transparent" BorderThickness="0,0,3,0"
                                BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="16" Height="12" VerticalAlignment="Center">
                                    <Rectangle Fill="{StaticResource DkTextSecondaryBrush}"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout1" Text="1 CỘT" FontSize="{StaticResource FontSizeCompact}"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           Foreground="{StaticResource DkTextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LayoutOpt2" Tag="2" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="18,9"
                                Background="{StaticResource DkBlueBgBrush}" BorderThickness="0,0,3,0"
                                BorderBrush="{StaticResource DkBlueLightBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="16" Height="12" VerticalAlignment="Center" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource DkBlueLightBrush}"/>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource DkBlueLightBrush}"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout2" Text="2 CỘT" FontSize="{StaticResource FontSizeCompact}"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           Foreground="{StaticResource DkBlueLightBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LayoutOpt3" Tag="3" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="18,9"
                                Background="Transparent" BorderThickness="0,0,3,0"
                                BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="16" Height="12" VerticalAlignment="Center" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource DkTextSecondaryBrush}"/>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource DkTextSecondaryBrush}"/>
                                    <Rectangle Grid.Column="2" Fill="{StaticResource DkTextSecondaryBrush}"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout3" Text="3 CỘT" FontSize="{StaticResource FontSizeCompact}"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           Foreground="{StaticResource DkTextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section: Danh sách cảm biến (nguồn kéo-thả) -->
                    <StackPanel Grid.Row="1">
                        <Rectangle Height="1" Fill="{StaticResource DkBorderSubtleBrush}" Margin="0,10,0,14"/>
                        <TextBlock Text="DANH SÁCH CẢM BIẾN" FontSize="{StaticResource FontSizeCaption}" FontFamily="Consolas"
                                   FontWeight="SemiBold" Foreground="{StaticResource DkTextDimBrush}"
                                   CharacterSpacing="80" Margin="18,0,18,2"/>
                        <TextBlock Text="Kéo cảm biến vào ô trống để hiển thị" FontSize="{StaticResource FontSizeXSmall}"
                                   Foreground="{StaticResource DkTextDimBrush}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="18,0,18,10"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SensorListPanel" Margin="0,0,0,12"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ─────────── CHARTS AREA ─────────── -->
            <!-- Named so ExpandCard()/CollapseExpandedCardAnimated() can measure a card's
                 on-screen position/size relative to this fixed, always-visible root before
                 re-parenting it, and compute a FLIP-style grow/shrink transform from it. -->
            <Grid x:Name="ChartsAreaRoot" Grid.Column="1" Background="{StaticResource DkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Charts header -->
                <Border Grid.Row="0" Padding="16,10"
                        BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="ChartsTitleText" Text="BẢNG ĐIỀU KHIỂN CẢM BIẾN" FontSize="{StaticResource FontSizeSubtitle}"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{StaticResource DkTextPrimaryBrush}"/>
                            <Border Background="{StaticResource DkSurfaceBrush}" Padding="8,3">
                                <TextBlock x:Name="ChartCountBadge" Text="0 / 0 hiển thị"
                                           FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"
                                           Foreground="{StaticResource DkBlueLightBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                            <Border Background="{StaticResource DkInputBgBrush}"
                                    BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="1"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="LỊCH SỬ" FontSize="{StaticResource FontSizeCaption}" FontFamily="Consolas"
                                               Foreground="{StaticResource DkTextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Border x:Name="HistOpt30" Tag="30" IsTapEnabled="True"
                                            Tapped="HistoryOption_Tapped" Padding="10,6"
                                            Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                        <TextBlock x:Name="HistLbl30" Text="30" FontSize="{StaticResource FontSizeCompact}"
                                                   FontFamily="Consolas" Foreground="{StaticResource DkTextMutedBrush}"/>
                                    </Border>
                                    <Border x:Name="HistOpt60" Tag="60" IsTapEnabled="True"
                                            Tapped="HistoryOption_Tapped" Padding="10,6"
                                            Background="{StaticResource DkBlueBgBrush}" BorderThickness="0" BorderBrush="Transparent">
                                        <TextBlock x:Name="HistLbl60" Text="60" FontSize="{StaticResource FontSizeCompact}" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{StaticResource DkBlueLightBrush}"/>
                                    </Border>
                                    <Border x:Name="HistOpt100" Tag="100" IsTapEnabled="True"
                                            Tapped="HistoryOption_Tapped" Padding="10,6"
                                            Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                        <TextBlock x:Name="HistLbl100" Text="100" FontSize="{StaticResource FontSizeCompact}"
                                                   FontFamily="Consolas" Foreground="{StaticResource DkTextMutedBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Button x:Name="AutoFillButton" Click="AutoFill_Click"
                                    Style="{StaticResource DkSecondaryButtonStyle}" Padding="14,7"
                                    ToolTipService.ToolTip="Tự động lấp đầy ô trống">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}"/>
                                    <TextBlock Text="LẤP ĐẦY" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Charts grid: fixed Row/Column cells sized by ratio (Grid Star sizing) — a
                     card grows by spanning whole cells, never by raw pixels, so a resize can't
                     push the layout past the viewport the way free-form pixel sizing could. -->
                <Border Grid.Row="1" Padding="14">
                    <Grid x:Name="ChartsHost" ColumnSpacing="16" RowSpacing="16"/>
                </Border>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Grid.Row="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="16" Visibility="Visible">
                    <Border Width="56" Height="56" Background="{StaticResource DkSurfaceBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="{StaticResource FontSizeXLarge}" Foreground="{StaticResource DkTextDimBrush}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyStateLabel" Text="ĐANG KẾT NỐI..."
                                   FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{StaticResource DkTextMutedBrush}" TextAlignment="Center"/>
                        <TextBlock Text="Waiting for sensor data stream" FontSize="{StaticResource FontSizeXSmall}"
                                   Foreground="{StaticResource DkTextDimBrush}" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="16,10"
                        BorderBrush="{StaticResource DkBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Cảm biến đã gán:" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"
                                           Foreground="{StaticResource DkTextDimBrush}"/>
                                <TextBlock x:Name="TotalNodesText" Text="0" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="{StaticResource DkTextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Cảnh báo:" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"
                                           Foreground="{StaticResource DkTextDimBrush}"/>
                                <TextBlock x:Name="ActiveAlertsText" Text="0" FontSize="{StaticResource FontSizeXSmall}" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="{StaticResource DkYellowBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7C2;" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource DkTextDimBrush}"/>
                            <TextBlock Text="Kéo cảm biến từ danh sách để hiển thị" FontSize="{StaticResource FontSizeXSmall}"
                                       Foreground="{StaticResource DkTextDimBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─────────── Fullscreen chart overlay (mirrors LiveVideoPage's camera-focus mode) ───────────
                     Spans the whole charts area (header/body/footer rows) and, when a card is expanded, hosts
                     that exact same card Border re-parented from ChartsHost — no chart/series rebuild, so the
                     live-updating series keeps ticking untouched while it's shown fullscreen. Background is a
                     translucent scrim (not opaque) so the grid underneath is dimmed rather than hard-cut, and
                     Opacity starts at 0 / the card host starts slightly scaled down so ExpandCard()/
                     CollapseExpandedCard() can animate both to/from their resting state (fade + pop). -->
                <Grid x:Name="FullscreenOverlay" Grid.Row="0" Grid.RowSpan="3"
                      Background="{StaticResource DkScrimBrush}" Padding="28"
                      Visibility="Collapsed" Opacity="0">
                    <!-- CompositeTransform's Center defaults to (0,0) — the element's own top-left
                         corner — which is exactly the anchor the FLIP math in PlayFullscreenTransition()
                         assumes (scale-then-translate from a corner, not RenderTransformOrigin's
                         normalized center point). Do not add RenderTransformOrigin here. -->
                    <Grid x:Name="FullscreenCardHost">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="FullscreenCardTransform"/>
                        </Grid.RenderTransform>
                    </Grid>
                    <Button Click="FullscreenClose_Click"
                            Style="{StaticResource DkIconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTipService.ToolTip="Thu nhỏ">
                        <FontIcon Glyph="&#xE73F;" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource DkTextMutedBrush}"/>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>
